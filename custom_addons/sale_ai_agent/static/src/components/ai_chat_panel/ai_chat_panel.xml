<!-- Clean Chat Area with Collapsible Capabilities Panel (Global Decision 5) -->
<templates xml:space="preserve">
    <t t-name="sale_ai_agent.AiChatPanel">
        <div class="o_ai_agent_container d-flex flex-column h-100 p-3 bg-light">
            <!-- Collapsible Capabilities Panel (What I can do) -->
            <div class="o_ai_capabilities_panel card shadow-sm mb-3">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 cursor-pointer" t-on-click="this.toggleCapabilities">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa fa-th-large text-primary"></i>
                        <strong class="text-dark">What I can do / إمكانيات المساعد</strong>
                    </div>
                    <i t-attf-class="fa fa-chevron-{{ this.state.isCapabilitiesOpen ? 'up' : 'down' }} text-muted"></i>
                </div>
                <div t-if="this.state.isCapabilitiesOpen" class="card-body p-3 bg-white border-top">
                    <div class="row g-3">
                        <t t-foreach="this.capabilities" t-as="dom" t-key="dom.name">
                            <div class="col-md-4">
                                <div class="border rounded p-2 h-100 bg-light">
                                    <h6 class="fw-bold mb-1 text-primary"><t t-out="dom.label"/></h6>
                                    <p class="small text-muted mb-2"><t t-out="dom.description"/></p>
                                    <div class="small fw-semibold mb-1 text-secondary">Examples / أمثلة:</div>
                                    <div class="d-flex flex-column gap-1">
                                        <t t-foreach="dom.examples" t-as="ex" t-key="ex">
                                            <button class="btn btn-sm btn-outline-secondary text-start py-0 px-2 text-truncate" t-on-click="() => this.setInputText(ex)">
                                                <i class="fa fa-terminal me-1 opacity-50"></i><t t-out="ex"/>
                                            </button>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Messages Stream Area -->
            <div class="o_ai_chat_messages flex-grow-1 overflow-auto p-3 bg-white rounded shadow-sm border mb-3" t-ref="this.messageList">
                <t t-if="!this.state.messages.length">
                    <div class="text-center py-5 text-muted">
                        <i class="fa fa-robot fa-3x mb-3 text-primary"></i>
                        <h5>Odoo 20 AI Operations Copilot</h5>
                        <p class="small text-muted">Ask questions or assign business operations across Sales, Purchase, Inventory, and Manufacturing.</p>
                    </div>
                </t>
                <t t-foreach="this.state.messages" t-as="msg" t-key="msg_index">
                    <div t-attf-class="d-flex mb-3 {{ msg.role === 'user' ? 'justify-content-end' : 'justify-content-start' }}">
                        <div t-attf-class="p-3 rounded-3 max-w-75 shadow-sm {{ msg.role === 'user' ? 'bg-primary text-white' : 'bg-light border text-dark' }}">
                            <div class="small fw-bold mb-1 opacity-75">
                                <t t-out="msg.role === 'user' ? 'You' : 'AI Assistant'"/>
                            </div>
                            <div class="o_msg_content text-break" style="white-space: pre-wrap;">
                                <t t-out="msg.content"/>
                            </div>
                            <!-- Inline Approval Card for T2 Interceptions -->
                            <t t-if="msg.approval">
                                <div class="alert alert-warning mt-2 mb-0 border shadow-sm p-2">
                                    <div class="fw-bold"><i class="fa fa-shield me-1"></i> Human Approval Required (Tier 2)</div>
                                    <div class="small mt-1"><t t-out="msg.approval.message"/></div>
                                    <div class="d-flex gap-2 mt-2">
                                        <a t-attf-href="/web#id={{msg.approval.approval_id}}&amp;model=ai.agent.approval&amp;view_type=form" target="_blank" class="btn btn-sm btn-warning">
                                            Review &amp; Approve
                                        </a>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Status Indicator -->
            <div t-if="this.state.statusText" class="text-muted small px-2 mb-2 d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                <t t-out="this.state.statusText"/>
            </div>

            <!-- Input Bar -->
            <div class="d-flex gap-2">
                <input type="text" class="form-control" placeholder="Ask a question or type a business instruction..." t-model.proxy="this.state.inputValue" t-on-keydown="this.onInputKeydown"/>
                <button class="btn btn-primary px-4 d-flex align-items-center gap-2" t-on-click="this.sendMessage" t-att-disabled="this.state.isSending">
                    <i class="fa fa-paper-plane"></i> Send
                </button>
            </div>
        </div>
    </t>
</templates>
