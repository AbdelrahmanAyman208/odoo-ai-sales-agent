<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_ai_agent" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.ai.agent</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ai_lead_followup"
                        type="object"
                        string="AI Follow-up Email"
                        class="btn-secondary"
                        icon="fa-magic"
                        title="Draft an AI-powered follow-up email for this opportunity"/>
            </xpath>
        </field>
    </record>
</odoo>
