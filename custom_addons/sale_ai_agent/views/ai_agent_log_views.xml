<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_agent_log_list" model="ir.ui.view">
        <field name="name">ai.agent.log.list</field>
        <field name="model">ai.agent.log</field>
        <field name="arch" type="xml">
            <list string="AI Agent Action Logs" create="0" delete="1">
                <field name="create_date" string="Date &amp; Time"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="source"/>
                <field name="model_name"/>
                <field name="execution_time" widget="float_time"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_ai_agent_log_form" model="ir.ui.view">
        <field name="name">ai.agent.log.form</field>
        <field name="model">ai.agent.log</field>
        <field name="arch" type="xml">
            <form string="AI Agent Log Details" create="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Execution Info">
                            <field name="user_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="source" readonly="1"/>
                            <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'error'"/>
                            <field name="execution_time" readonly="1"/>
                        </group>
                        <group string="Target Record">
                            <field name="model_name" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="error_message" readonly="1" invisible="not error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="User Prompt" name="prompt">
                            <field name="prompt" readonly="1" widget="text"/>
                        </page>
                        <page string="AI Response" name="response">
                            <field name="response" readonly="1" widget="text"/>
                        </page>
                        <page string="Tools Executed" name="tools" invisible="not tools_called">
                            <field name="tools_called" readonly="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_agent_log" model="ir.actions.act_window">
        <field name="name">Sales Action History</field>
        <field name="res_model">ai.agent.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
