<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_ai_agent" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ai.agent</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ai_followup_email"
                        type="object"
                        string="AI Follow-up Email"
                        class="btn-primary"
                        icon="fa-magic"
                        title="Draft an AI-powered persuasive follow-up email for this quotation"
                        invisible="state not in ('draft', 'sent', 'sale')"/>
            </xpath>
        </field>
    </record>
</odoo>
