<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_agent_chat_wizard_form" model="ir.ui.view">
        <field name="name">ai.agent.chat.wizard.form</field>
        <field name="model">ai.agent.chat</field>
        <field name="arch" type="xml">
            <form string="AI Assistant">
                <sheet>
                    <!-- Quick action bar -->
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button name="action_quick_end_to_end_usecase" type="object" string="🚀 Full Flow (Sales + MRP + PO)" class="btn btn-sm btn-primary fw-bold"/>
                        <button name="action_quick_crm_lead_gen" type="object" string="🎯 Lead Generation" class="btn btn-sm btn-outline-info"/>
                        <button name="action_quick_pipeline" type="object" string="📊 CRM Pipeline" class="btn btn-sm btn-outline-info"/>
                        <button name="action_quick_quote" type="object" string="📝 Create Quote" class="btn btn-sm btn-outline-success"/>
                        <button name="action_quick_loyalty_promo" type="object" string="🎁 15% Promo Code" class="btn btn-sm btn-outline-success"/>
                        <button name="action_quick_project_task" type="object" string="📋 Project &amp; Task" class="btn btn-sm btn-outline-primary"/>
                        <button name="action_quick_replenishment" type="object" string="📦 Replenishment" class="btn btn-sm btn-outline-warning"/>
                        <button name="action_quick_analyze_offers" type="object" string="📈 Vendor Offers" class="btn btn-sm btn-outline-secondary"/>
                        <button type="button" class="btn btn-sm btn-outline-secondary o_ai_chat_hide_btn fw-bold ms-auto" title="Minimize / Hide Chatbot to bottom dock">➖ Minimize (—)</button>
                        <button name="action_reset_chat" type="object" string="🗑️ Reset Chat" class="btn btn-sm btn-outline-danger"/>
                    </div>

                    <!-- Alert banner if sale order was created -->
                    <div class="alert alert-success d-flex align-items-center justify-content-between p-2 mb-3" role="alert" invisible="not last_order_id">
                        <div>
                            <strong>✨ Quotation Created!</strong>
                            <span class="ms-2">A new draft sales quotation is ready for your review.</span>
                        </div>
                        <button name="action_view_order" type="object" string="Open Quotation" class="btn btn-sm btn-success" icon="fa-external-link"/>
                    </div>

                    <!-- Alert banner if purchase order was created -->
                    <div class="alert alert-warning d-flex align-items-center justify-content-between p-2 mb-3" role="alert" invisible="not last_po_id">
                        <div>
                            <strong>📋 Purchase Order / RFQ Created!</strong>
                            <span class="ms-2">A new purchase order draft is ready for supplier validation.</span>
                        </div>
                        <button name="action_view_po" type="object" string="Open Purchase Order" class="btn btn-sm btn-warning" icon="fa-external-link"/>
                    </div>

                    <!-- Alert banner if product was created -->
                    <div class="alert alert-primary d-flex align-items-center justify-content-between p-2 mb-3" role="alert" invisible="not last_product_id">
                        <div>
                            <strong>✨ Product Created!</strong>
                            <span class="ms-2">The product and its components are available in the catalog.</span>
                        </div>
                        <button name="action_view_product" type="object" string="Open Product" class="btn btn-sm btn-primary" icon="fa-external-link"/>
                    </div>

                    <!-- Alert banner if T2 approval is pending -->
                    <div class="alert alert-danger d-flex align-items-center justify-content-between p-2 mb-3" role="alert" invisible="not last_approval_id">
                        <div>
                            <strong>🛡️ Human Approval Required!</strong>
                            <span class="ms-2">A T2 operation needs your review and confirmation.</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button name="action_open_approval_target" type="object" string="🔍 Go to Record" class="btn btn-sm btn-outline-danger" icon="fa-external-link" title="Open the target record (Purchase/Sales Order) directly to review and confirm"/>
                            <button name="action_view_approval" type="object" string="📋 Open Approval" class="btn btn-sm btn-danger" icon="fa-shield" title="Open the Approval card to review details and execute the two-step confirmation"/>
                        </div>
                    </div>

                    <!-- Chat scroll area -->
                    <div class="mb-3">
                        <field name="chat_html" widget="html" readonly="1" nolabel="1"/>
                    </div>

                    <!-- Input box -->
                    <div class="mt-2">
                        <field name="user_message" placeholder="Ask AI Agent (e.g. 'Create CRM lead for TechCorp', 'Apply 10% promo to SO002', 'Setup project for office move', 'Generate 20 coupons')..." widget="text" rows="2" class="form-control"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_send_message" string="Send 🚀" type="object" class="btn btn-primary"/>
                    <button string="Close" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ai_agent_chat" model="ir.actions.act_window">
        <field name="name">AI Operations Agent</field>
        <field name="res_model">ai.agent.chat</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
